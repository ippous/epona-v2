# Base Neon (production). Laisser vide en local : une base embarquée (PGlite) est créée dans .pglite/
DATABASE_URL=

# Facultatif : secret de signature des sessions (sinon généré et conservé en base)
SESSION_SECRET=

# Facultatif : premier compte administrateur (sinon créé depuis l'écran d'installation)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Nom affiché dans l'appli
NEXT_PUBLIC_APP_NAME=Epona v2
