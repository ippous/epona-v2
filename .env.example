# Base Neon (production). Laisser vide en local : une base embarquée (PGlite) est créée dans .pglite/
DATABASE_URL=

# Secret de signature des sessions : 32 caractères aléatoires minimum
SESSION_SECRET=

# Premier compte administrateur, créé automatiquement si la base ne contient aucun utilisateur
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Nom affiché dans l'appli
NEXT_PUBLIC_APP_NAME=Jury
